
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MusicHub - Your Personal Music Library</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #333;
        }

        header {
            background: #202040;
            color: white;
            padding: 25px;
            text-align: center;
        }

        .container {
            max-width: 1000px;
            margin: 30px auto;
            padding: 20px;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .account-area {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .welcome {
            font-weight: bold;
            color: #202040;
        }

        button, .btn {
            background: #3939a5;
            color: white;
            padding: 11px 16px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-size: 14px;
        }

        button:hover, .btn:hover {
            background: #25256e;
        }

        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .register, .ajax-button, .edit {
            background: #16834a;
        }

        .logout, .delete {
            background: #c0392b;
        }

        .search-area {
            margin: 25px 0;
            position: relative;
        }

        .search-form {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        input[type="text"] {
            padding: 12px;
            width: 280px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        #suggestions {
            display: none;
            width: 100%;
            max-width: 500px;
            background: white;
            border: 1px solid #ccc;
            margin-top: 5px;
            border-radius: 5px;
            overflow: hidden;
        }

        .suggestion {
            padding: 12px;
            cursor: pointer;
            border-bottom: 1px solid #eee;
        }

        .suggestion:hover {
            background: #eeeeff;
        }

        #ajaxStatus {
            margin-top: 8px;
            color: #555;
        }

        .song {
            background: white;
            padding: 20px;
            margin-bottom: 18px;
            border-radius: 8px;
            box-shadow: 0 2px 7px rgba(0,0,0,0.08);
        }

        .song h2 {
            color: #202040;
            margin-top: 0;
        }

        .details {
            color: #555;
            line-height: 1.7;
        }

        details {
            margin-top: 12px;
        }

        summary {
            cursor: pointer;
            color: #3939a5;
            font-weight: bold;
        }

        .actions {
            margin-top: 15px;
            display: flex;
            gap: 10px;
        }

        .message {
            background: white;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
        }

        .error {
            background: #ffecec;
            color: #c0392b;
            padding: 12px;
            border-radius: 5px;
        }

        .success {
            background: #e5f6e9;
            color: #236b35;
            padding: 12px;
            border-radius: 5px;
            margin-bottom: 15px;
        }

        footer {
            text-align: center;
            padding: 20px;
            color: #777;
        }

        @media (max-width: 600px) {
            .container {
                padding: 12px;
            }

            input[type="text"] {
                width: 100%;
            }

            .account-area {
                justify-content: flex-start;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>MusicHub</h1>
    <p>Your Personal Music Library</p>
</header>

<div class="container">

    <div class="top-bar">

        <h2>Music Collection</h2>

        <div class="account-area">

            {% if isLoggedIn %}

                <span class="welcome">
                    Welcome, {{ username }}
                </span>

                <a href="add_music.php" class="btn">
                    + Add New Music
                </a>

                <form method="POST" action="logout.php">
                    <input type="hidden"
                           name="csrf_token"
                           value="{{ csrf_token }}">

                    <button type="submit" class="logout">
                        Logout
                    </button>
                </form>

            {% else %}

                <a href="login.php" class="btn">Login</a>

                <a href="register.php" class="btn register">
                    Register
                </a>

            {% endif %}

        </div>

    </div>

    <!-- Success messages -->

    {% if added %}
        <div class="success">
            Music added successfully!
        </div>
    {% endif %}

    {% if updated %}
        <div class="success">
            Music updated successfully!
        </div>
    {% endif %}

    {% if deleted %}
        <div class="success">
            Music deleted successfully!
        </div>
    {% endif %}

    <!-- Search section -->

    <div class="search-area">

        <form method="GET"
              action="index.php"
              class="search-form"
              id="searchForm">

            <input type="text"
                   id="musicSearch"
                   name="search"
                   maxlength="100"
                   placeholder="Enter song or artist name..."
                   value="{{ search }}"
                   autocomplete="off">

            <button type="submit">
                Normal Search
            </button>

            <button type="button"
                    id="ajaxSearchButton"
                    class="ajax-button">
                AJAX Search
            </button>

            <a href="index.php" class="btn">
                Show All
            </a>

        </form>

        <div id="suggestions"></div>

        <div id="ajaxStatus" aria-live="polite"></div>

    </div>

    {% if searchError %}
        <p class="error">{{ searchError }}</p>
    {% endif %}

    {% if databaseError %}

        <p class="error">{{ databaseError }}</p>

    {% else %}

        <p>{{ songs|length }} music record(s) found.</p>

        {% if songs is not empty %}

            {% for song in songs %}

                <div class="song">

                    <h2>{{ song.title }}</h2>

                    <div class="details">

                        <strong>Artist:</strong>
                        {{ song.artist }}<br>

                        <strong>Album:</strong>
                        {{ song.album }}<br>

                        <strong>Genre:</strong>
                        {{ song.genre }}<br>

                        <strong>Release Year:</strong>
                        {{ song.release_year }}<br>

                        <strong>Description:</strong>
                        {{ song.description }}

                    </div>

                    {% if song.lyrics %}

                        <details>
                            <summary>View Lyrics</summary>
                            <p>{{ song.lyrics|nl2br }}</p>
                        </details>

                    {% endif %}

                    {% if isLoggedIn %}

                        <div class="actions">

                            <a href="edit_music.php?id={{ song.music_id }}"
                               class="btn edit">
                                Edit
                            </a>

                            <a href="delete_music.php?id={{ song.music_id }}"
                               class="btn delete">
                                Delete
                            </a>

                        </div>

                    {% endif %}

                </div>

            {% endfor %}

        {% else %}

            <div class="message">
                <h3>No music found</h3>
                <p>Try another song or artist name.</p>
            </div>

        {% endif %}

    {% endif %}

</div>

<footer>
    <p>&copy; {{ "now"|date("Y") }} MusicHub. All rights reserved.</p>
</footer>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const searchInput = document.getElementById('musicSearch');
    const ajaxButton = document.getElementById('ajaxSearchButton');
    const suggestionBox = document.getElementById('suggestions');
    const ajaxStatus = document.getElementById('ajaxStatus');
    const searchForm = document.getElementById('searchForm');

    let requestNumber = 0;

    function performAjaxSearch() {

        const term = searchInput.value.trim();
        const currentRequest = ++requestNumber;

        suggestionBox.replaceChildren();
        suggestionBox.style.display = 'none';
        ajaxStatus.textContent = '';

        if (term.length === 0) {
            ajaxStatus.textContent =
                'Please enter a song or artist name.';
            return;
        }

        if (term.length > 100) {
            ajaxStatus.textContent =
                'Search must not exceed 100 characters.';
            return;
        }

        ajaxButton.disabled = true;
        ajaxButton.textContent = 'Searching...';

        fetch('ajax_search.php?term=' + encodeURIComponent(term))
            .then(function (response) {

                if (!response.ok) {
                    throw new Error('Server error: ' + response.status);
                }

                return response.json();

            })
            .then(function (data) {

                if (currentRequest !== requestNumber) {
                    return;
                }

                suggestionBox.replaceChildren();

                if (!Array.isArray(data) || data.length === 0) {
                    ajaxStatus.textContent = 'No music found.';
                    return;
                }

                ajaxStatus.textContent =
                    data.length + ' result(s) found.';

                data.forEach(function (song) {

                    const item = document.createElement('div');

                    item.className = 'suggestion';

                    item.textContent =
                        song.title + ' - ' + song.artist;

                    item.addEventListener('click', function () {

                        searchInput.value = song.title;
                        searchForm.submit();

                    });

                    suggestionBox.appendChild(item);

                });

                suggestionBox.style.display = 'block';

            })
            .catch(function (error) {

                if (currentRequest !== requestNumber) {
                    return;
                }

                console.error(error);

                ajaxStatus.textContent =
                    'AJAX search failed. Please try again.';

            })
            .finally(function () {

                if (currentRequest === requestNumber) {
                    ajaxButton.disabled = false;
                    ajaxButton.textContent = 'AJAX Search';
                }

            });

    }

    ajaxButton.addEventListener('click', performAjaxSearch);

    searchInput.addEventListener('input', function () {

        if (searchInput.value.trim().length >= 2) {
            performAjaxSearch();
        } else {
            requestNumber++;
            suggestionBox.replaceChildren();
            suggestionBox.style.display = 'none';
            ajaxStatus.textContent = '';
            ajaxButton.disabled = false;
            ajaxButton.textContent = 'AJAX Search';
        }

    });

    document.addEventListener('click', function (event) {

        if (!event.target.closest('.search-area')) {
            suggestionBox.style.display = 'none';
        }

    });

});
</script>

</body>
</html>
